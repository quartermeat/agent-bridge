[Unit]
Description=Agent Bridge local voice conversation
Wants=pipewire.service pipewire-pulse.service
After=graphical-session.target pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h
# Voice requests have read-only Codex access. Journal RMS readings help tune --vad-threshold.
ExecStart=%h/.local/bin/agent-bridge voice --source alsa_input.pci-0000_28_00.4.analog-stereo --wake-word "hey agent" --vad-threshold 0.08
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
