[Unit]
Description=Agent Bridge local voice conversation
Wants=pipewire.service pipewire-pulse.service
After=graphical-session.target pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h
# Voice requests go to a read-only Claude Code session (--agent codex selects Codex). Journal RMS readings help tune --vad-threshold.
# Select Starship Rear Mic before capture; its ALSA mux can otherwise remain on Line.
ExecStartPre=/usr/bin/amixer -c Generic sset "Input Source,0" "Rear Mic"
ExecStart=%h/.local/bin/agent-bridge voice --agent claude --source alsa_input.pci-0000_28_00.4.analog-stereo --wake-word "hey agent" --vad-threshold 0.03 --speech-gain 6
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
